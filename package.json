{
  "name": "dsh-user-status",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "把当前窗口、空闲时长和 QQ音乐播放的歌告诉大肥鱼，并在侧栏显示",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "collector.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
